# Veritabanı (RAM kısıtlı sunucu için bağlantı havuzu küçük tutuldu)
DATABASE_URL="postgresql://sf_user:DEGISTIRIN@localhost:5432/software_factory?schema=public&connection_limit=5"

# Auth.js (NextAuth v5)
# Üretmek için: openssl rand -base64 32
AUTH_SECRET=""
# Ters vekil (nginx/caddy) arkasında çalışırken zorunlu
AUTH_TRUST_HOST="true"
# Üretimde gerçek alan adınız, örn: https://panel.alanadiniz.com
AUTH_URL="http://localhost:3000"

# Sağlayıcı anahtarları, SSH anahtarları ve 2FA sırları için şifreleme anahtarı (AES-256-GCM)
# Üretmek için: openssl rand -base64 32
# DİKKAT: Kaybolursa şifreli veriler geri alınamaz. Güvenli bir yerde yedekleyin.
APP_ENCRYPTION_KEY=""

# Tohum verisi (yalnızca `npm run db:seed` için)
# Boş bırakırsanız şifreler rastgele üretilir ve terminale bir kez yazdırılır.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_PARTNER_PASSWORD=""
SEED_STAFF_PASSWORD=""
# Dolu veritabanını silip yeniden tohumlamak için "true" yapın (DİKKAT: tüm veriyi siler)
SEED_RESET="false"
